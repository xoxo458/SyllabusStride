    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "uuid": "^9.0.1",
    "express-validator": "^7.0.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "appwrite": "^14.0.0",
    "@clerk/express": "^1.0.0",
    "sentry-express": "^7.85.0",
    "@sentry/node": "^7.85.0",
    "nodemailer": "^6.9.7",
    "axios": "^1.6.2",
