# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ============================================
# Database Configuration (Appwrite)
# ============================================
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key
APPWRITE_DATABASE_ID=syllabustride_db

# Collections
APPWRITE_USERS_COLLECTION=users
APPWRITE_COURSES_COLLECTION=courses
APPWRITE_ASSIGNMENTS_COLLECTION=assignments
APPWRITE_SUBMISSIONS_COLLECTION=submissions

# Storage Buckets
APPWRITE_STORAGE_BUCKET_SYLLABUS=syllabi
APPWRITE_STORAGE_BUCKET_UPLOADS=user_uploads

# ============================================
# Authentication (Clerk)
# ============================================
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
CLERK_AFTER_SIGN_IN_URL=/dashboard
CLERK_AFTER_SIGN_UP_URL=/onboarding

# ============================================
# Alternative: Appwrite Auth (if using Appwrite Auth instead)
# ============================================
# APPWRITE_AUTH_ENABLED=true

# ============================================
# Email & Notifications (Testmail)
# ============================================
TESTMAIL_API_KEY=your_testmail_api_key
TESTMAIL_NAMESPACE=your_testmail_namespace
TESTMAIL_SMTP_HOST=testmail.app
TESTMAIL_SMTP_PORT=2525
TESTMAIL_SMTP_USER=your_testmail_username
TESTMAIL_SMTP_PASSWORD=your_testmail_password

# Email Configuration
SMTP_FROM_EMAIL=noreply@syllabustride.com
SMTP_FROM_NAME=SyllabusStride

# ============================================
# Error Tracking (Sentry)
# ============================================
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development
SENTRY_TRACE_SAMPLE_RATE=0.1
SENTRY_PROFILE_SAMPLE_RATE=0.1

# ============================================
# API Configuration
# ============================================
API_BASE_URL=http://localhost:3000
API_PREFIX=/api/v1
API_VERSION=1.0.0

# CORS Configuration
CORS_ORIGIN=http://localhost:*,http://10.0.2.2:*
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE=50000000
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx
UPLOAD_TIMEOUT=300000

# ============================================
# JWT Configuration (if using JWT alongside Clerk)
# ============================================
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# ============================================
# Feature Flags
# ============================================
ENABLE_APPWRITE_AUTH=false
ENABLE_CLERK_AUTH=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_SENTRY=true
ENABLE_TESTMAIL=true

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Cache Configuration
# ============================================
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379

# ============================================
# Development/Debug
# ============================================
DEBUG=syllabustride:*
SUPPRESS_LOGS=false
